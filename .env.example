# Runtime template. Copy to a git-ignored file and fill values privately.
# node scripts/setup-docker-env.mjs creates .env.docker with random local
# secrets without printing them or overwriting an existing file.
APP_ORIGIN=
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
USE_SECURE_COOKIES=true
MARKETING_ENABLE_DEMO_AUTH=false
MARKETING_ENABLE_SYNTHETIC_CRM=false
MARKETING_ENABLE_ADMIN_PREVIEW=false
MARKETING_USERS_JSON=[]
LOCAL_PORT=3100
# Required for PostgreSQL database persistence.
DB_PASSWORD=
